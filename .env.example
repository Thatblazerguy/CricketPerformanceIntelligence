# CPI Environment Variables
# Copy this file to .env and fill in your values.

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://cpi:cpi@localhost:5432/cpi_db

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Data Directories ---
# Absolute paths to Cricsheet JSON match files
IPL_DATA_DIR=../data/raw/ipl/matches
T20I_DATA_DIR=../data/raw/t20i/matches

# --- Optional: OpenCricket API (not required for Cricsheet-only operation) ---
# Verify current pricing, endpoints and terms before enabling.
# OPENCRICKET_API_KEY=
# OPENCRICKET_BASE_URL=

# --- Optional: Cricket Database player enrichment (server-side only) ---
# CRICKET_DATABASE_API_KEY=
# CRICKET_DATABASE_BASE_URL=https://api.cricketdatabase.com/v1
