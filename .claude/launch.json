{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cpi-api",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "cd backend && exec .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "cpi-frontend",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "cd frontend && exec npm run dev"],
      "port": 5173
    }
  ]
}
