# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── Secrets & local config ────────────────────────────────────────────────────
.env
.env.*
*.secret

# ── Full game dataset (never ship in image) ───────────────────────────────────
gamedata/
data/raw/
data/staging/
data/backups/
data/processed/
data/reports/

# ── Backend ───────────────────────────────────────────────────────────────────
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/logs/
backend/artifacts/win_probability/cache/
backend/tests/

# ── Frontend (context is ./frontend, so paths are relative to it) ─────────────
node_modules/
dist/
.vite/
*.local

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
